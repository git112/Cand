# ========================================
# Candor Memory System — env.example
# ========================================
# Copy this to `.env` and fill in values you actually want to use.
# Everything in the project works with zero keys filled in. You only
# need these if you want the nicer generative answers path; otherwise
# the rule-based extractive fallback is used.

# --- LLM providers for memory answer generation (any or all) ---------
# Groq has a generous free tier, Llama-3.3-70b, fast. Recommended default.
GROQ_API_KEY=
# Optionally override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini free tier: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible endpoint (any: OpenAI proper, Together, local Ollama proxy, etc.)
# Harness --judge openai also reads these. Point OPENAI_BASE_URL=https://api.groq.com/openai/v1
# and set OPENAI_API_KEY=groq_... to use Groq as the harness judge.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (used by --judge claude-cli)
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20240229

# --- Eval harness: LLM-judge shortcut --------------------------------
# Example judge run using Groq as the OpenAI-compatible backend:
#   set OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   set OPENAI_API_KEY=<your groq key>
#   cd eval_harness && python score_memory.py --judge openai ^
#       --gold ../evals/memory_train.jsonl --answers ../outputs/memory_train_answers.jsonl

# --- Optional voice (bonus) ----------------------------------------
# Browser-side Web Speech needs nothing (UI mic button uses it).
# Server-side ASR uses Groq Whisper -> local Whisper -> Windows SAPI5,
# in that priority order, all graceful fallbacks.
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENAI_WHISPER_MODEL=whisper-1
ELEVENLABS_API_KEY=

# --- Bolna AI hosted voice agent (bonus, WEBHOOK-ONLY integration) -----
# Docs: https://docs.bolna.dev     Sign-up: https://platform.bolna.dev
#
# TWO MODES (pick 1, both are pure webhook, no audio processed locally):
#
#   (A) Manual configure (RECOMMENDED — simpler):
#       1. Build your agent visually at https://platform.bolna.dev/agent-studio
#       2. Copy its agent ID into BOLNA_AGENT_ID below.
#       3. Run `python voice.py --print-webhook-url` and paste the URL it prints
#          into Bolna → Agent Studio → Extractions tab → Webhook URL.
#       4. OR run `python voice.py --register-webhook` which calls
#          PATCH /v2/agent/{id} and sets agent_config.webhook_url for you.
#
#   (B) Programmatic: leave BOLNA_AGENT_ID blank, keep BOLNA_API_KEY set.
#       First call `python voice.py --bolna-agent` POSTs /v2/agent with the
#       webhook_url included in agent_config.
#
# BOLNA_WEBHOOK_URL is optional; if blank we compute as HOST:PORT + /api/voice/bolna/webhook.
# For dev tunnels use:  cloudflared tunnel --url http://127.0.0.1:8787
#                       ngrok http 8787
# then paste the resulting HTTPS URL here with the /api/voice/bolna/webhook path.
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_AGENT_ID=
BOLNA_AGENT_NAME=Candor-Alex-Desktop
# BOLNA_WEBHOOK_URL=https://<your-public-host>/api/voice/bolna/webhook
BOLNA_WEBHOOK_URL=

# --- Real (non-dry-run) integrations (bonus, OPT-IN, KILL-SWITCH) -----
#
# Unless INTEGRATIONS_ACTUALLY_EXECUTE is literally "1", ALL calls to
# integrations.py Executor log the planned args and return success as
# dry-run (no Slack/Gmail/Calendar/OS tasks are EVER performed by default).
#
# Hidden action test harness never enables this; it reads only the JSON
# plan. Enable ONLY in a trusted personal environment.
INTEGRATIONS_ACTUALLY_EXECUTE=0

# Slack real chat.postMessage (bot token, chat:write scope)
# SLACK_BOT_TOKEN=

# Gmail real send (SMTP fallback — no OAuth needed for smoke tests).
GMAIL_FROM=alex@brightline.example.com
# GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
# GMAIL_SMTP_USER=alex@brightline.example.com
# GMAIL_SMTP_PASSWORD=

# Google Calendar (stubbed — placeholder creds, never executes actions by default).
# GOOGLE_CALENDAR_SERVICE_JSON=
# CALENDAR_CLIENT_ID=
# CALENDAR_CLIENT_SECRET=
# CALENDAR_REFRESH_TOKEN=

# Reminders scheduled at the OS level (Windows schtasks / mac osascript / linux at + notify-send).
REMINDERS_USE_SCHEDULED_TASKS=0

# Product UI (server.py)
CANDOR_HOST=127.0.0.1
CANDOR_PORT=8787
CANDOR_DATA_DIR=data
